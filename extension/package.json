{
  "name": "collectab",
  "description": "A Toby-like bookmark manager with organizations, collections, and real-time sync",
  "private": true,
  "version": "0.2.18",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "concurrently --kill-others --names \"wxt,firefox\" \"wxt -b firefox\" \"sleep 2 && web-ext run --source-dir=.output/firefox-mv2-dev --target=firefox-desktop\"",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:firefox:run": "pnpm build:firefox && web-ext run --source-dir=.output/firefox-mv2 --target=firefox-desktop",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "loro-crdt": "^1.4.11",
    "lucide-react": "^0.511.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.0.307",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "web-ext": "^10.5.0",
    "wxt": "^0.20.27"
  }
}
