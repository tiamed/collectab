# ============================================================
# 必配（生产环境）
# ============================================================
# 本地开发改为 development（允许 http://localhost 与默认密钥）
NODE_ENV=production
# 使用仓库根目录 docker-compose.yml 时：DATABASE_URL 由 compose 根据 POSTGRES_PASSWORD 生成，无需填写
POSTGRES_PASSWORD=change-this-db-password
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/collectab
# 用 `openssl rand -base64 32` 生成；生产环境使用示例值会拒绝启动。更换后所有会话失效
BETTER_AUTH_SECRET=change-this-to-a-random-secret-at-least-32-chars
# 服务器对外的 HTTPS 源（不带 /api），扩展里填 <BETTER_AUTH_URL>/api。生产环境必须 https://
BETTER_AUTH_URL=https://api.example.com
# 在 nginx/Caddy 等反向代理之后运行时设为 true（代理需设置 X-Real-IP 或 X-Forwarded-For），
# 否则所有用户共享同一个限流桶。直接暴露 Node 端口时保持 false
TRUST_PROXY=true
PORT=3001
HOST=0.0.0.0

# ============================================================
# 扩展 / 跨域
# ============================================================
# 允许登录的扩展 ID（逗号分隔，Chrome 商店分配的 32 位 ID，或完整的 chrome-extension://… / moz-extension:// 源）。
# 留空 = 任意扩展都可连接（自建可以；公网服务建议填上商店 ID，加 moz-extension:// 以支持 Firefox）
EXTENSION_IDS=
# 额外允许 CORS 的网页源（逗号分隔）。默认只允许本服务器自身 + 上面的扩展源；* 表示任意源
CORS_ORIGIN=
# 额外的 Better Auth 可信源（逗号分隔），一般无需配置
TRUSTED_ORIGINS=

# ============================================================
# 会话
# ============================================================
# 会话为滑动过期：连续 N 天未使用才失效；活跃会话每 M 小时续期一次（无需 refresh）
SESSION_EXPIRES_DAYS=30
SESSION_UPDATE_AGE_HOURS=24

# ============================================================
# 注册、角色与配额
# ============================================================
# 注册模式：open（任何人可注册，获得 DEFAULT_ROLE）| invite-only（仅邀请链接可注册）
INVITE_MODE=open
# 新用户角色：guest（受限）| user | admin
DEFAULT_ROLE=guest
# 管理员用户 ID（逗号分隔），这些用户自动拥有管理员权限（可创建邀请、改角色）
ADMIN_USER_IDS=
# 各角色的书签配额（逗号分隔 role=数量，unlimited 表示无限制）。未列出的角色用默认值
ROLE_QUOTAS=guest=10,user=500,admin=unlimited
# 设为 true 可完全关闭配额限制（所有用户无限制）
DISABLE_QUOTAS=false

# ============================================================
# 可选：邮件（Resend）—— 密码重置邮件、私有邀请邮件
# ============================================================
RESEND_API_KEY=
RESEND_FROM_EMAIL=Collectab <noreply@example.com>

# ============================================================
# 可选：Google 登录
# Google Cloud Console → OAuth 客户端（Web application）
# 已获授权的重定向 URI：<BETTER_AUTH_URL>/api/auth/callback/google
# ============================================================
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# ============================================================
# 限流（仅 /api/auth/*，按客户端 IP + 路径计数）
# 登录/注册另有内置规则：每 IP 10 秒 3 次
# ============================================================
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=100

# ============================================================
# 隐私政策页 /privacy（Chrome 商店需要隐私政策链接）
# ============================================================
PRIVACY_OPERATOR_NAME=
PRIVACY_CONTACT_EMAIL=
